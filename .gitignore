# =============================================================================
# Vial-QMK Custom Fork - Selective Tracking
# =============================================================================
# This .gitignore excludes the entire vial-qmk base to keep the repo minimal.
# Only custom keymap(s) and surgically modified core files are tracked.
#
# To use this fork:
#   1. Clone the official vial-qmk repository
#   2. Apply these tracked files on top
#   3. Build normally with: qmk compile -kb xcmkb/sofleplus2 -km arleo
# =============================================================================

# Ignore everything by default
*

# =============================================================================
# CUSTOM KEYMAP - Track arleo keymap only
# =============================================================================
!keyboards/
!keyboards/xcmkb/
!keyboards/xcmkb/sofleplus2/
!keyboards/xcmkb/sofleplus2/keymaps/
!keyboards/xcmkb/sofleplus2/keymaps/arleo/
!keyboards/xcmkb/sofleplus2/keymaps/arleo/**

# Ignore board-level config (not keymap-specific)
keyboards/xcmkb/sofleplus2/config.h

# =============================================================================
# MODIFIED VIAL CORE FILES
# User callback hooks for tapping term, flow tap, alt repeat key
# =============================================================================
!quantum/
!quantum/vial.c
!quantum/vial.h
!quantum/qmk_settings.c
!quantum/qmk_settings.h

# Ignore other quantum files
quantum/unicode/

# =============================================================================
# REPO METADATA
# =============================================================================
!.gitignore
!README.md

# =============================================================================
# BUILD ARTIFACTS - Always ignore
# =============================================================================
**/*.o
**/*.d
**/*.elf
**/*.hex
**/*.bin
**/*.uf2
**/*.map
**/*.lst
**/*.sym
**/.build/
**/build/
